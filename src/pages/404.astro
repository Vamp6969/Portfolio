---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Doodle from '../components/Doodle.astro';
---

<BaseLayout
  title="404: Not found | Tushar A."
  description="The page you're looking for doesn't exist on tushar-a.dev. Head back home or try one of the suggested routes."
  noindex
>
  <Nav />

  <main class="not-found container">
    <div class="nf-block">
      <Doodle name="crumpled" width={220} class="nf-doodle" />
      <p class="nf-code">404</p>
      <h1 class="nf-title">This page got DDoS'd off the internet.</h1>
      <p class="nf-body">
        Or, more likely, the URL doesn't exist. Try one of these:
      </p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/witchly" class="btn">Witchly case study</a>
        <a href="/resume" class="btn">Resume</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .not-found {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 120px;
    padding-bottom: 80px;
    text-align: center;
  }

  .nf-block { max-width: 620px; }

  .nf-block :global(.nf-doodle) { margin: 0 auto 8px; transform: rotate(-8deg); }

  .nf-code {
    font-family: var(--font-hand);
    font-size: clamp(6rem, 18vw, 10rem);
    line-height: 0.9;
    color: var(--ink);
    transform: rotate(-3deg);
  }

  .nf-title {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    color: var(--ink);
    margin: 10px 0 14px;
  }

  .nf-body {
    color: var(--muted);
    font-size: 1.05rem;
    margin-bottom: 32px;
  }

  .nf-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
