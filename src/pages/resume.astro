---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Resume | Tushar A., Systems Engineer & Founder"
  description="Resume of Tushar A., Systems Engineer & Founder of Witchly.host. 5+ years scaling infrastructure. Linux, Docker, Hetzner, Mailcow, MCP, OpenEnv."
  keywords="Tushar A resume, devops engineer, systems engineer, infrastructure, hire, Bangalore, full-time"
>
  <Nav />

  <main class="container resume-page">
    <a href="/" class="back-link">← Back to home</a>

    <article class="sketch resume-head reveal">
      <p class="section-eyebrow">/resume</p>
      <h1 class="resume-title">Resume</h1>
      <p class="resume-deck">
        Systems engineer and startup founder. 4+ years building distributed
        infrastructure, developer tools, and consumer platforms across TypeScript,
        Rust, Python, React, and Cloudflare Workers.
      </p>
      <div class="resume-meta">
        <a href="mailto:tushar@tushar-a.dev">tushar@tushar-a.dev</a>
        <span class="dot">·</span>
        <a href="https://github.com/Vamp6969" target="_blank" rel="noopener">@Vamp6969</a>
        <span class="dot">·</span>
        <a href="https://www.linkedin.com/in/tushar-a-dev/" target="_blank" rel="noopener">LinkedIn</a>
        <span class="dot">·</span>
        <a href="/Resume.pdf" target="_blank" rel="noopener">Download PDF →</a>
      </div>
    </article>

    <section class="resume-stats reveal" aria-label="Resume highlights">
      <div class="resume-stats-row">
        <div class="rstat">
          <span class="rstat-value">4+</span>
          <span class="rstat-label">Years experience</span>
        </div>
        <div class="rstat">
          <span class="rstat-value">10K+</span>
          <span class="rstat-label">Users scaled</span>
        </div>
        <div class="rstat">
          <span class="rstat-value">2nd place</span>
          <span class="rstat-label">Boot-to-Root, Cyber Storm 2026</span>
        </div>
        <div class="rstat">
          <span class="rstat-value">B.Tech</span>
          <span class="rstat-label">CSE · AI/ML</span>
        </div>
      </div>
    </section>

    <article class="sketch resume-intro reveal">
      <h2 class="resume-h">What's inside</h2>
      <ul class="resume-bullets">
        <li>
          <strong>Witchly.host</strong>: founder & lead systems engineer of a free
          game-server hosting platform. 10,000+ users on bare-metal Hetzner with
          cgroup tenant isolation. Mitigated a 50 Gbps L7 DDoS in under 20 minutes.
          Built the dashboard, billing, and Discord-bot order pipeline from scratch.
        </li>
        <li>
          <strong>MistyMC.xyz</strong>: co-founder & web developer. Designed and
          maintain the public-facing site and web infrastructure for a Minecraft
          server network.
        </li>
        <li>
          <strong>Auto-Examiner</strong>: self-improving RL environment on PyTorch +
          FastAPI. Qualified Round 1 of the Meta PyTorch OpenEnv Hackathon × Scaler
          School of Technology (31,000+ registered participants).
        </li>
        <li>
          <strong>Code Debug Env</strong>: OpenEnv where AI agents debug
          progressively harder Python via subprocess-sandboxed execution with
          partial-credit scoring.
        </li>
        <li>
          <strong>India Finance MCP</strong>: MCP server + REST API exposing
          47,000+ AMFI mutual fund NAVs and GSTIN validation. Hono on Cloudflare
          Workers; deployed on Apify for AI-agent discovery.
        </li>
        <li>
          <strong>Docspell</strong>: AI document platform on Cloudflare Pages + D1
          + R2 with Gemini and Claude APIs. Three-tier SaaS (Free / $16 Pro / $49
          Team), in active development.
        </li>
        <li>
          <strong>Education</strong>: B.Tech CSE (AI/ML), Presidency University
          Bangalore. Expected 2028.
        </li>
      </ul>
    </article>

    <article class="sketch resume-pdf reveal" aria-label="Resume PDF">
      <object
        data="/Resume.pdf"
        type="application/pdf"
        class="pdf-frame"
        aria-label="Tushar A. resume PDF"
      >
        <div class="pdf-fallback">
          <p>
            Your browser can't display the PDF inline.
            <a href="/Resume.pdf" target="_blank" rel="noopener">
              Download the resume →
            </a>
          </p>
        </div>
      </object>
    </article>

    <article class="note note-violet resume-cta reveal" style="--tilt:-0.8deg">
      <h2>Want to chat about a role?</h2>
      <div class="resume-cta-row">
        <a href="/#contact" class="btn btn-primary">Get in touch</a>
        <a href="/Resume.pdf" class="btn" target="_blank" rel="noopener">
          Download PDF
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .resume-page {
    padding-top: 110px;
    padding-bottom: 56px;
    max-width: 1060px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .back-link:hover { color: var(--violet-ink); }

  .resume-head,
  .resume-intro,
  .resume-pdf { margin-bottom: 32px; }

  .resume-head { padding: clamp(28px, 4vw, 44px); }

  .resume-title {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 4.6rem);
    line-height: 1;
    color: var(--ink);
    margin: 4px 0 14px;
  }

  .resume-deck {
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    max-width: 760px;
    margin-bottom: 18px;
  }

  .resume-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-weight: 600;
  }

  .resume-meta .dot { color: var(--muted); }

  .resume-meta a {
    color: var(--violet-ink);
    text-decoration: underline wavy color-mix(in srgb, var(--violet-ink) 40%, transparent);
    text-underline-offset: 4px;
  }

  .resume-stats { margin-bottom: 40px; }

  .resume-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }

  .rstat-value {
    display: block;
    font-family: var(--font-hand);
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--ink);
  }

  .rstat-label {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .resume-stats-row { grid-template-columns: repeat(2, 1fr); }
  }

  .resume-h {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 2rem;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .resume-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .resume-bullets li {
    position: relative;
    padding-left: 26px;
    color: var(--muted);
  }

  .resume-bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    font-family: var(--font-hand);
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .resume-bullets strong { color: var(--ink); }

  .resume-pdf { padding: 10px; }

  .pdf-frame {
    width: 100%;
    height: 85vh;
    min-height: 600px;
    display: block;
    border-radius: 4px;
    background: #fff;
  }

  @media (max-width: 540px) {
    .pdf-frame { height: 70vh; min-height: 420px; }
  }

  .pdf-fallback {
    padding: 60px 30px;
    text-align: center;
    color: var(--muted);
  }

  .pdf-fallback a { color: var(--violet-ink); font-weight: 700; }

  .resume-cta {
    text-align: center;
    padding: clamp(36px, 5vw, 52px);
    max-width: 720px;
    margin: 56px auto 0;
  }

  .resume-cta h2 {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    margin-bottom: 18px;
  }

  .resume-cta-row {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
