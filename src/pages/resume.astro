---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Tushar A. — Resume"
  description="Tushar A. resume — Systems Engineer & Founder. Linux, Docker, Hetzner, Mailcow, MCP, OpenEnv."
>
  <Nav />

  <main class="container resume-page">
    <a href="/" class="back-link">← Back to home</a>

    <article class="tile resume-head reveal">
      <p class="section-eyebrow">/resume</p>
      <h1 class="resume-title">Resume</h1>
      <p class="resume-deck">
        Systems Engineer & Founder · Bangalore, India · 5+ years scaling distributed
        infrastructure. Available for full-time DevOps / infra / platform roles.
      </p>
      <div class="resume-meta">
        <a href="mailto:tushar@tushar-a.dev">tushar@tushar-a.dev</a>
        <span class="dot">·</span>
        <a href="https://github.com/Vamp6969" target="_blank" rel="noopener">@Vamp6969</a>
        <span class="dot">·</span>
        <a href="https://www.linkedin.com/in/tushar-a-607371315" target="_blank" rel="noopener">LinkedIn</a>
        <span class="dot">·</span>
        <a href="/Resume.pdf" target="_blank" rel="noopener">Download PDF →</a>
      </div>
    </article>

    <article class="tile resume-pdf reveal" aria-label="Resume PDF">
      <object
        data="/Resume.pdf"
        type="application/pdf"
        class="pdf-frame"
        aria-label="Tushar A. resume PDF"
      >
        <div class="pdf-fallback">
          <p>
            Your browser can't display the PDF inline.
            <a href="/Resume.pdf" target="_blank" rel="noopener">
              Download the resume →
            </a>
          </p>
        </div>
      </object>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .resume-page {
    padding-top: 100px;
    padding-bottom: 40px;
    max-width: 1100px;
  }

  .back-link {
    display: inline-block;
    color: var(--muted-3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 24px;
    transition: color 0.2s var(--ease);
  }

  .back-link:hover {
    color: var(--primary-soft);
  }

  .resume-head {
    padding: clamp(28px, 4vw, 44px);
    background:
      radial-gradient(circle at 20% 20%, rgba(99, 102, 241, 0.10), transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(168, 85, 247, 0.08), transparent 50%),
      var(--tile-bg);
    margin-bottom: 18px;
  }

  .resume-title {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 1;
    background: linear-gradient(135deg, #fff 0%, var(--primary-soft) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 8px 0 14px;
  }

  .resume-deck {
    color: var(--text);
    font-size: clamp(0.98rem, 1.6vw, 1.12rem);
    line-height: 1.6;
    max-width: 760px;
    margin-bottom: 18px;
  }

  .resume-meta {
    color: var(--muted-3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .resume-meta .dot {
    opacity: 0.5;
  }

  .resume-meta a {
    color: var(--primary-soft);
    transition: color 0.2s var(--ease);
  }

  .resume-meta a:hover {
    color: var(--accent);
  }

  .resume-pdf {
    padding: 8px;
  }

  .pdf-frame {
    width: 100%;
    height: 85vh;
    min-height: 600px;
    border-radius: 10px;
    background: #1a1a22;
    display: block;
  }

  .pdf-fallback {
    padding: 60px 30px;
    text-align: center;
    color: var(--muted);
  }

  .pdf-fallback a {
    color: var(--primary-soft);
  }

  @media (max-width: 540px) {
    .pdf-frame {
      height: 70vh;
      min-height: 500px;
    }
  }
</style>
