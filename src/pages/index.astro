---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';
import NowBlock from '../components/NowBlock.astro';
import Timeline from '../components/Timeline.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SkillGroup from '../components/SkillGroup.astro';
import ContactGrid from '../components/ContactGrid.astro';
import Footer from '../components/Footer.astro';

const experience = [
  {
    role: 'Founder & Sole Operator',
    org: 'Witchly.host',
    link: 'https://witchly.host',
    period: '2021 – Present',
    location: 'Remote',
    bullets: [
      'Single-handedly own and operate a game-hosting ISP — infrastructure, ops, support, billing, and the customer-facing site.',
      'Scaled to 10,000+ users on Hetzner bare-metal with zero external funding. 99.9% uptime under high-concurrency workloads.',
      'Engineered isolated game environments using Docker and Pterodactyl with cgroup limits to prevent tenant resource contention.',
      'Self-hosted Mailcow with full SPF/DKIM/DMARC/PTR; 10/10 deliverability for transactional email.',
      'Mitigated volumetric DDoS attacks and unauthorized SSH attempts via UFW firewalls and Fail2Ban jails.',
    ],
  },
  {
    role: 'Web Developer',
    org: 'MistyMC.xyz',
    link: 'https://mistymc.xyz',
    period: 'May 2026 – Present',
    location: 'Remote',
    bullets: [
      'Develops and maintains the main public site for a Minecraft network.',
      'Scope is the website only — not infrastructure or the network itself.',
    ],
  },
];

const skills = [
  {
    title: 'Infrastructure',
    tags: ['Linux (Ubuntu / CentOS)', 'Docker', 'Pterodactyl', 'Bare Metal', 'Hetzner Cloud'],
  },
  {
    title: 'Networking & Security',
    tags: ['Nginx Reverse Proxy', 'Cloudflare DNS', 'UFW / Fail2Ban', 'SSL / TLS', 'Mailcow (SPF/DKIM/DMARC)'],
  },
  {
    title: 'Backend & Languages',
    tags: ['Python', 'TypeScript', 'C++', 'Java', 'Bash', 'MySQL / MariaDB', 'LAMP'],
  },
  {
    title: 'AI/ML & Tools',
    tags: ['OpenEnv', 'FastMCP', 'FastAPI', 'Hono', 'Next.js', 'Cloudflare Workers', 'Git'],
  },
];
---

<BaseLayout
  title="Tushar A. — Systems Engineer & Founder"
  description="Systems Engineer & Founder. Scaling distributed infrastructure to 10,000+ users on bare-metal Linux, Docker, and Hetzner."
>
  <Nav />
  <main>
    <Hero />
    <StatsStrip />
    <NowBlock />
    <Timeline entries={experience} />
    <ProjectGrid />

    <section class="skills section" id="skills">
      <h2 class="section-title reveal">
        <span class="section-number">03.</span> Technical arsenal
      </h2>
      <div class="container">
        <div class="skills-grid">
          {skills.map((s) => <SkillGroup title={s.title} tags={s.tags} />)}
        </div>
      </div>
    </section>

    <ContactGrid />
  </main>
  <Footer />
</BaseLayout>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
</style>
