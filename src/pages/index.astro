---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';
import NowBlock from '../components/NowBlock.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

const experience = [
  {
    role: 'Founder & Lead Systems Engineer',
    org: 'Witchly.host',
    link: 'https://witchly.host',
    period: '2021 — Present',
    location: 'Remote',
    bullets: [
      'Founded a free game-server hosting platform; scaled to 10,000+ registered users and thousands of concurrent Docker containers, fully bootstrapped with zero external funding.',
      'Architected a distributed bare-metal cluster on Hetzner with cgroup-based tenant isolation (CPU pinning, RAM limits) — 99.9% uptime at a fraction of equivalent cloud compute cost (€100/mo vs $3,000+/mo on AWS).',
      'Mitigated a 50 Gbps+ L7 DDoS through layered edge / network / host defences; full service restored in under 20 minutes with zero data loss.',
      "Built an automated order-to-provision pipeline via a custom Discord bot integrated with payment-gateway APIs — instant server activation, no manual intervention.",
      'Shipped a custom dashboard from scratch with native Stripe billing, real-time per-server resource visibility, and REST APIs for provisioning and lifecycle management.',
    ],
  },
  {
    role: 'Co-Founder & Web Developer',
    org: 'MistyMC.xyz',
    link: 'https://mistymc.xyz',
    period: '2025 — Present',
    location: 'Remote',
    bullets: [
      'Co-founded a Minecraft server network; designed, built, and maintain the public-facing site and web infrastructure supporting a growing player community.',
    ],
  },
];

const skillGroups = [
  {
    cat: 'languages',
    description: 'What I write in day to day.',
    tags: ['TypeScript', 'Rust', 'Python', 'C++', 'Java', 'Bash'],
  },
  {
    cat: 'frontend',
    description: 'Web and cross-platform UI work.',
    tags: ['React', 'Expo (RN)', 'Tauri', 'Tailwind CSS', 'Astro'],
  },
  {
    cat: 'backend',
    description: 'API frameworks and edge runtimes.',
    tags: ['Hono', 'Cloudflare Workers', 'FastAPI', 'Node.js', 'Nginx'],
  },
  {
    cat: 'infrastructure',
    description: 'Bare-metal, containers, the boring foundations.',
    tags: ['Linux (Ubuntu/CentOS)', 'Docker', 'Pterodactyl', 'Hetzner', 'UFW / Fail2Ban'],
  },
  {
    cat: 'data',
    description: 'Storage and persistence.',
    tags: ['PostgreSQL', 'MySQL / MariaDB', 'Cloudflare D1', 'Cloudflare R2'],
  },
  {
    cat: 'ai/ml',
    description: 'Models, agent runtimes, and the MCP world.',
    tags: ['PyTorch', 'OpenEnv', 'MCP Protocol', 'OpenAI API', 'Gemini API', 'Claude API'],
  },
];
---

<BaseLayout
  title="Tushar A. — Systems Engineer & Founder"
  description="Systems Engineer & Founder. Scaled a game-hosting ISP solo to 10,000+ users on bare-metal Hetzner. Available for full-time DevOps / infrastructure roles."
  keywords="Tushar A, systems engineer, devops, infrastructure, founder, Witchly, bare-metal, Hetzner, Docker, Linux, Bangalore"
>
  <Nav />

  <main>
    <Hero />
    <NowBlock />
    <StatsStrip />
    <ExperienceSection entries={experience} />
    <ProjectsSection />
    <SkillsSection groups={skillGroups} />
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
