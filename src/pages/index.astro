---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';
import NowBlock from '../components/NowBlock.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

const experience = [
  {
    role: 'Founder & Sole Operator',
    org: 'Witchly.host',
    link: 'https://witchly.host',
    period: '2021 — Present',
    location: 'Remote',
    bullets: [
      'Single-handedly own and operate a game-hosting ISP — infrastructure, ops, support, billing, and the customer-facing site.',
      'Scaled to 10,000+ users on Hetzner bare-metal with zero external funding. 99.9% uptime under high-concurrency workloads via kernel tuning.',
      'Engineered isolated game environments with Docker + Pterodactyl and cgroup limits to prevent tenant resource contention.',
      'Self-hosted Mailcow with full SPF/DKIM/DMARC/PTR — 10/10 deliverability for transactional email.',
      'Mitigated volumetric DDoS attacks and brute-force SSH attempts via UFW firewalls and Fail2Ban jails.',
    ],
  },
  {
    role: 'Web Developer',
    org: 'MistyMC.xyz',
    link: 'https://mistymc.xyz',
    period: 'May 2026 — Present',
    location: 'Remote',
    bullets: [
      'Develop and maintain the main public site for a Minecraft network. Scope: website only — not the network or its infrastructure.',
    ],
  },
];

const skillGroups = [
  {
    cat: 'infra',
    description: 'Bare-metal Linux, container orchestration, the boring foundations.',
    tags: ['Linux (Ubuntu/CentOS)', 'Docker', 'Pterodactyl', 'Bare Metal', 'Hetzner Cloud'],
  },
  {
    cat: 'net+sec',
    description: 'Edge, DNS, mail authentication, intrusion mitigation.',
    tags: ['Nginx Reverse Proxy', 'Cloudflare DNS', 'UFW / Fail2Ban', 'SSL / TLS', 'Mailcow'],
  },
  {
    cat: 'code',
    description: 'Languages and storage I reach for daily.',
    tags: ['Python', 'TypeScript', 'C++', 'Java', 'Bash', 'MySQL / MariaDB', 'LAMP'],
  },
  {
    cat: 'ai/ml',
    description: 'Newer plumbing — RL environments, MCP servers, edge runtimes.',
    tags: ['OpenEnv', 'FastMCP', 'FastAPI', 'Hono', 'Next.js', 'Cloudflare Workers'],
  },
];
---

<BaseLayout
  title="Tushar A. — Systems Engineer & Founder"
  description="Systems Engineer & Founder. Scaling distributed infrastructure to 10,000+ users on bare-metal Linux, Docker, and Hetzner."
>
  <Nav />

  <main>
    <Hero />
    <NowBlock />
    <StatsStrip />
    <ExperienceSection entries={experience} />
    <ProjectsSection />
    <SkillsSection groups={skillGroups} />
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
