---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import HeroTile from '../components/HeroTile.astro';
import StatsStrip from '../components/StatsStrip.astro';
import NowTile from '../components/NowTile.astro';
import ExperienceTile from '../components/ExperienceTile.astro';
import ProjectTile from '../components/ProjectTile.astro';
import SkillsTile from '../components/SkillsTile.astro';
import ContactTile from '../components/ContactTile.astro';
import Footer from '../components/Footer.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const featured = projects.find((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);

const experience = [
  {
    role: 'Founder & Sole Operator',
    org: 'Witchly.host',
    link: 'https://witchly.host',
    period: '2021 — Present',
    blurb:
      'Single-handedly own and operate a game-hosting ISP — infra, ops, support, billing, the public site. 10,000+ users on Hetzner bare-metal, 99.9% uptime. Docker + Pterodactyl tenant isolation. Self-hosted Mailcow at 10/10 deliverability.',
  },
  {
    role: 'Web Developer',
    org: 'MistyMC.xyz',
    link: 'https://mistymc.xyz',
    period: 'May 2026 — Now',
    blurb:
      'Develop and maintain the main public site for a Minecraft network. Scope: website only.',
  },
];

const skillGroups = [
  { cat: 'infra', tags: ['linux', 'docker', 'pterodactyl', 'bare-metal', 'hetzner'] },
  { cat: 'net+sec', tags: ['nginx', 'cloudflare', 'ufw', 'fail2ban', 'mailcow'] },
  { cat: 'code', tags: ['python', 'typescript', 'c++', 'java', 'bash', 'mysql'] },
  { cat: 'ai/ml', tags: ['openenv', 'fastmcp', 'fastapi', 'hono', 'next.js'] },
];
---

<BaseLayout
  title="Tushar A. — Systems Engineer & Founder"
  description="Systems Engineer & Founder. Scaling distributed infrastructure to 10,000+ users on bare-metal Linux, Docker, and Hetzner."
>
  <Nav />

  <main class="container main">
    <div class="bento" id="projects">
      <HeroTile />
      <StatsStrip />
      <NowTile />
      <ExperienceTile entries={experience} />
      {featured && <ProjectTile project={featured} />}
      {others.map((p) => <ProjectTile project={p} />)}
      <SkillsTile groups={skillGroups} />
      <ContactTile />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main {
    padding-top: 88px;
    padding-bottom: 32px;
  }
</style>
