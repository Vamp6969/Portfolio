---
interface Entry {
  role: string;
  org: string;
  link?: string;
  period: string;
  blurb: string;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<article class="tile exp-tile span-7 row-3 reveal" id="experience">
  <p class="tile-label">/experience</p>
  <h2 class="exp-h">Where I've worked</h2>

  <div class="exp-list">
    {entries.map((e) => (
      <div class="exp-row">
        <span class="exp-dot" aria-hidden="true"></span>
        <div class="exp-info">
          <p class="exp-role">
            {e.role} <span class="exp-org">@ {e.link ? <a href={e.link} target="_blank" rel="noopener">{e.org}</a> : e.org}</span>
          </p>
          <p class="exp-blurb">{e.blurb}</p>
        </div>
        <p class="exp-period">{e.period}</p>
      </div>
    ))}
  </div>
</article>

<style>
  .exp-tile {
    display: flex;
    flex-direction: column;
  }

  .exp-h {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: 12px;
  }

  .exp-list {
    display: flex;
    flex-direction: column;
  }

  .exp-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    gap: 14px;
    padding: 12px 0;
    align-items: start;
    border-bottom: 1px solid var(--divider);
  }

  .exp-row:last-child {
    border-bottom: none;
  }

  .exp-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary-soft);
    margin-top: 8px;
    box-shadow: 0 0 10px rgba(165, 180, 252, 0.5);
  }

  .exp-role {
    color: var(--text-strong);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .exp-org {
    color: var(--primary-soft);
    font-weight: 500;
  }

  .exp-org a {
    color: inherit;
    border-bottom: 1px dashed transparent;
    transition: border-color 0.2s var(--ease);
  }

  .exp-org a:hover {
    border-bottom-color: currentColor;
  }

  .exp-blurb {
    color: var(--muted-2);
    font-size: 0.82rem;
    line-height: 1.55;
    margin-top: 4px;
  }

  .exp-period {
    color: var(--muted-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-align: right;
    white-space: nowrap;
    align-self: start;
    margin-top: 4px;
  }

  @media (max-width: 540px) {
    .exp-row {
      grid-template-columns: 14px 1fr;
    }
    .exp-period {
      grid-column: 2;
      text-align: left;
      margin-top: 6px;
    }
  }
</style>
