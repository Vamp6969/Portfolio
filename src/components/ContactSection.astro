---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Doodle from './Doodle.astro';
import Scribble from './Scribble.astro';

interface Contact {
  label: string;
  value: string;
  href: string;
  external?: boolean;
}

const contacts: Contact[] = [
  { label: 'WhatsApp', value: '+91 9113058142', href: 'https://wa.me/+919113058142', external: true },
  { label: 'GitHub', value: '@Vamp6969', href: 'https://github.com/Vamp6969', external: true },
  { label: 'GitHub (org)', value: '@Witchly', href: 'https://github.com/Witchly', external: true },
  { label: 'LinkedIn', value: 'tushar-a-dev', href: 'https://www.linkedin.com/in/tushar-a-dev/', external: true },
  { label: 'Discord', value: '@vamp_', href: 'https://discord.com/users/844426168793825330', external: true },
];
---

<section class="contact section" id="contact" aria-label="Get in touch">
  <div class="container">
    <div class="postcard reveal" style="--tilt: -1deg">
      <div class="pc-message">
        <p class="section-eyebrow">/contact</p>
        <h2 class="section-title">Let's build something.</h2>
        <p class="pc-body">
          Open to full-time DevOps / infrastructure / platform engineering roles. Also up for consulting on
          scaling, hosting, and infra security. Inbox is always open.
        </p>
        <a href="mailto:tushar@tushar-a.dev" class="pc-email">
          tushar@tushar-a.dev
          <Scribble kind="underline" color="var(--violet-ink)" class="pc-underline" />
        </a>
        <span class="pc-hint">← email is best</span>
        <Doodle name="paper-plane" width={150} class="pc-plane" />
      </div>

      <div class="pc-side">
        <div class="pc-stamp" aria-hidden="true">
          <Image src={avatar} alt="" width={84} height={84} class="pc-stamp-img" />
          <span>BLR · IN</span>
        </div>
        <span class="pc-postmark" aria-hidden="true">open to<br />work</span>

        <ul class="pc-lines">
          {contacts.map((c) => (
            <li>
              <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>
                <span class="pc-key">{c.label}</span>
                <span class="pc-val">{c.value} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .postcard {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: var(--bg-elev);
    border: var(--stroke);
    box-shadow: var(--shadow), var(--paper-shadow);
    border-radius: 6px;
    padding: clamp(24px, 4vw, 48px);
    gap: clamp(24px, 4vw, 48px);
    position: relative;
  }

  .pc-message {
    position: relative;
    padding-right: clamp(0px, 3vw, 40px);
    border-right: 2px solid var(--ink);
  }

  .pc-body {
    color: var(--muted);
    margin-bottom: 26px;
    max-width: 480px;
  }

  .pc-email {
    display: inline-block;
    font-family: var(--font-hand);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .pc-email :global(.pc-underline) { width: 100%; height: 14px; }
  .pc-email:hover { color: var(--violet-ink); }

  .pc-hint {
    display: block;
    font-family: var(--font-hand);
    font-size: 1.2rem;
    color: var(--violet-ink);
    margin-top: 4px;
    transform: rotate(-2deg);
  }

  .pc-message :global(.pc-plane) {
    position: absolute;
    right: 24px;
    bottom: -10px;
    transform: rotate(-8deg);
  }

  .pc-side { position: relative; }

  .pc-stamp {
    float: right;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 8px 4px;
    background: var(--pink);
    color: #1f1d1a;
    /* perforated edge */
    outline: 3px dotted var(--bg-elev);
    outline-offset: -3px;
    border: 2px solid var(--ink);
    transform: rotate(4deg);
    margin: 0 0 16px 16px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .pc-stamp-img {
    image-rendering: pixelated;
    border: 1.5px solid var(--ink);
  }

  .pc-postmark {
    position: absolute;
    top: 30px;
    right: 96px;
    display: grid;
    place-items: center;
    width: 86px;
    height: 86px;
    border: 2px solid color-mix(in srgb, var(--violet-ink) 60%, transparent);
    border-radius: 50%;
    font-family: var(--font-hand);
    font-size: 1rem;
    line-height: 1;
    text-align: center;
    color: color-mix(in srgb, var(--violet-ink) 75%, transparent);
    transform: rotate(-14deg);
    pointer-events: none;
  }

  .pc-lines {
    clear: both;
    list-style: none;
    padding-top: 8px;
  }

  .pc-lines a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 10px 2px 6px;
    border-bottom: 1.5px solid color-mix(in srgb, var(--ink) 50%, transparent);
    transition: padding 0.2s var(--ease);
  }

  .pc-lines a:hover { padding-left: 8px; }
  .pc-lines a:hover .pc-val { color: var(--violet-ink); }

  .pc-key {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--muted);
  }

  .pc-val { font-weight: 600; text-align: right; }

  @media (max-width: 860px) {
    .postcard { grid-template-columns: 1fr; }
    .pc-message { border-right: 0; border-bottom: 2px solid var(--ink); padding: 0 0 28px; }
    .pc-message :global(.pc-plane) { display: none; }
  }
</style>
