---
interface Contact {
  label: string;
  value: string;
  href: string;
  external?: boolean;
}

const contacts: Contact[] = [
  { label: 'Email', value: 'tushar@tushar-a.dev', href: 'mailto:tushar@tushar-a.dev' },
  { label: 'WhatsApp', value: '+91 9113058142', href: 'https://wa.me/+919113058142', external: true },
  { label: 'GitHub', value: '@Vamp6969', href: 'https://github.com/Vamp6969', external: true },
  { label: 'GitHub (org)', value: '@Witchly', href: 'https://github.com/Witchly', external: true },
  { label: 'LinkedIn', value: 'tushar-a-dev', href: 'https://www.linkedin.com/in/tushar-a-dev/', external: true },
  { label: 'Discord', value: '@vamp_', href: 'https://discord.com/users/844426168793825330', external: true },
];
---

<section class="contact section" id="contact" aria-label="Get in touch">
  <div class="container">
    <header class="contact-head reveal">
      <p class="section-eyebrow">/contact</p>
      <h2 class="section-title">Let's build something.</h2>
      <p class="section-lede">
        Open to full-time DevOps / infrastructure / platform engineering roles. Also up
        for consulting on scaling, hosting, and infra security. Inbox is always open.
      </p>
    </header>

    <div class="contact-grid">
      <a href="mailto:tushar@tushar-a.dev" class="contact-primary reveal">
        <span class="cp-eyebrow">Email is best</span>
        <span class="cp-value">tushar@tushar-a.dev</span>
        <span class="cp-arrow" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M3 10H17M17 10L10 3M17 10L10 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>

      <ul class="contact-list reveal">
        {contacts.map((c) => (
          <li>
            <a
              href={c.href}
              class="contact-row"
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener' : undefined}
            >
              <span class="contact-key">{c.label}</span>
              <span class="contact-val">{c.value}</span>
              <svg class="contact-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-head {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .contact-head .section-eyebrow,
  .contact-head .section-lede {
    margin-left: auto;
    margin-right: auto;
  }

  .contact-head .section-eyebrow {
    justify-content: center;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 16px;
    max-width: 980px;
    margin: 0 auto;
  }

  @media (max-width: 720px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-primary {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 3.5vw, 40px);
    background:
      linear-gradient(135deg, rgba(99, 102, 241, 0.10), rgba(168, 85, 247, 0.06)),
      var(--tile-bg);
    border: 1px solid var(--tile-border);
    border-radius: var(--tile-radius);
    backdrop-filter: blur(14px);
    transition:
      border-color 0.3s var(--ease),
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
    overflow: hidden;
  }

  .contact-primary:hover {
    border-color: rgba(165, 180, 252, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 20px 48px rgba(99, 102, 241, 0.18);
  }

  .cp-eyebrow {
    color: var(--primary-soft);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .cp-value {
    color: var(--text-strong);
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.5px;
    word-break: break-all;
  }

  .cp-arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    color: var(--primary-soft);
    transition: transform 0.3s var(--ease);
  }

  .contact-primary:hover .cp-arrow {
    transform: translate(4px, -4px);
  }

  .contact-list {
    list-style: none;
    background: var(--tile-bg);
    border: 1px solid var(--tile-border);
    border-radius: var(--tile-radius);
    padding: 12px;
    backdrop-filter: blur(12px);
  }

  .contact-row {
    display: grid;
    grid-template-columns: minmax(80px, auto) 1fr 14px;
    gap: 14px;
    align-items: center;
    min-height: 44px;
    padding: 12px 14px;
    border-radius: 8px;
    transition: background 0.2s var(--ease);
  }

  .contact-row:hover {
    background: rgba(165, 180, 252, 0.07);
  }

  .contact-key {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .contact-val {
    color: var(--text-strong);
    font-size: 0.92rem;
    font-weight: 500;
    overflow-wrap: anywhere;
    word-break: break-word;
    text-align: right;
    min-width: 0;
  }

  .contact-arrow {
    color: var(--muted-3);
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .contact-row:hover .contact-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
</style>
