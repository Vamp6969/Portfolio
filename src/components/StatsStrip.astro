---
interface Stat {
  value: string;
  label: string;
  numeric: number;
  prefix?: string;
  suffix?: string;
  color?: 'primary' | 'good';
  spark?: number[]; // optional sparkline points (0-10 range)
}

const stats: Stat[] = [
  {
    value: '10K+',
    label: 'users',
    numeric: 10000,
    suffix: '+',
    color: 'primary',
    spark: [1, 1.5, 2, 2.2, 3.1, 3.8, 4.6, 6, 7, 8.2, 9, 10],
  },
  {
    value: '99.9%',
    label: 'uptime',
    numeric: 99.9,
    suffix: '%',
    color: 'good',
    spark: [9.9, 9.8, 9.95, 9.92, 9.95, 9.98, 9.95, 9.99, 9.98, 9.99, 9.97, 9.99],
  },
  { value: '5+', label: 'yrs sysadmin', numeric: 5, suffix: '+', color: 'primary' },
  { value: '5', label: 'shipped', numeric: 5, color: 'primary' },
];

function buildPolyline(spark: number[]): string {
  const w = 80;
  const h = 18;
  const max = Math.max(...spark);
  const min = Math.min(...spark);
  const range = max - min || 1;
  return spark
    .map((v, i) => {
      const x = (i / (spark.length - 1)) * w;
      const y = h - ((v - min) / range) * (h - 2) - 1;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
}
---

{stats.map((stat, i) => (
  <article class:list={['tile stat-tile span-2 row-2 reveal', `stat-${stat.color}`]}>
    <p class="tile-label">/{stat.label}</p>
    <div class="stat-body">
      <span
        class="stat-value"
        data-numeric={stat.numeric}
        data-prefix={stat.prefix ?? ''}
        data-suffix={stat.suffix ?? ''}
        data-final={stat.value}
      >{stat.value}</span>
      <span class="stat-label-sub">{i === 0 ? 'scaled' : i === 1 ? 'sustained' : i === 2 ? 'sysadmin' : 'projects'}</span>
      {stat.spark && (
        <svg class="stat-spark" viewBox="0 0 80 18" preserveAspectRatio="none" aria-hidden="true">
          <polyline points={buildPolyline(stat.spark)} fill="none" stroke-width="1.5" />
        </svg>
      )}
    </div>
  </article>
))}

<style>
  .stat-tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 96px;
  }

  .stat-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
    background: linear-gradient(135deg, var(--primary-soft), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-feature-settings: 'tnum';
  }

  .stat-good .stat-value {
    background: linear-gradient(135deg, var(--good-soft), var(--good));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-label-sub {
    color: var(--muted-3);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .stat-spark {
    height: 18px;
    width: 100%;
    margin-top: 4px;
    opacity: 0.55;
  }

  .stat-primary .stat-spark polyline {
    stroke: var(--primary-soft);
  }
  .stat-good .stat-spark polyline {
    stroke: var(--good-soft);
  }
</style>

<script>
  // Animate counters once on first scroll-into-view. Disabled under reduced-motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.numeric ?? '0');
      const prefix = el.dataset.prefix ?? '';
      const suffix = el.dataset.suffix ?? '';
      const final = el.dataset.final ?? el.textContent ?? '';
      const isDecimal = !Number.isInteger(target);
      const duration = 1400;
      const start = performance.now();

      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const eased = easeOut(t);
        const current = target * eased;
        if (target >= 1000 && !isDecimal) {
          const k = current / 1000;
          el.textContent = prefix + (k < 10 ? k.toFixed(1) : Math.round(k)) + 'K' + suffix;
        } else {
          el.textContent = prefix + (isDecimal ? current.toFixed(1) : Math.round(current).toString()) + suffix;
        }
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = final;
      };

      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 },
    );

    document.querySelectorAll<HTMLElement>('.stat-value').forEach((el) => io.observe(el));
  }
</script>
