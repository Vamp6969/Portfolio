---
interface Stat {
  value: string;
  label: string;
  numeric: number;
  prefix?: string;
  suffix?: string;
  variant?: 'primary' | 'good';
}

const stats: Stat[] = [
  { value: '10K+', label: 'Users scaled', numeric: 10000, suffix: '+', variant: 'primary' },
  { value: '99.9%', label: 'Uptime sustained', numeric: 99.9, suffix: '%', variant: 'good' },
  { value: '5+', label: 'Years sysadmin', numeric: 5, suffix: '+', variant: 'primary' },
  { value: '5', label: 'Shipped projects', numeric: 5, variant: 'primary' },
];
---

<section class="stats" aria-label="Career stats">
  <div class="container">
    <div class="stats-row reveal">
      {stats.map((stat, i) => (
        <>
          <div class:list={['stat', `stat-${stat.variant}`]}>
            <span
              class="stat-value"
              data-numeric={stat.numeric}
              data-prefix={stat.prefix ?? ''}
              data-suffix={stat.suffix ?? ''}
              data-final={stat.value}
            >{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
          {i < stats.length - 1 && <div class="stat-divider" aria-hidden="true"></div>}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(40px, 5vw, 64px);
  }

  .stats-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 28px clamp(20px, 3vw, 36px);
    background: var(--tile-bg);
    border: 1px solid var(--tile-border);
    border-radius: var(--tile-radius);
    backdrop-filter: blur(12px);
  }

  .stat {
    flex: 1;
    text-align: center;
    min-width: 120px;
  }

  .stat-value {
    display: block;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -1.2px;
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
    background: linear-gradient(135deg, var(--primary-soft), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-good .stat-value {
    background: linear-gradient(135deg, var(--good-soft), var(--good));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-label {
    display: block;
    margin-top: 8px;
    color: var(--muted-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
  }

  @media (max-width: 720px) {
    .stats-row {
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px 16px;
      padding: 28px 20px;
    }
    .stat {
      flex: 0 1 calc(50% - 16px);
    }
    .stat-divider { display: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.numeric ?? '0');
      const prefix = el.dataset.prefix ?? '';
      const suffix = el.dataset.suffix ?? '';
      const final = el.dataset.final ?? el.textContent ?? '';
      const isDecimal = !Number.isInteger(target);
      const duration = 1500;
      const start = performance.now();

      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const eased = easeOut(t);
        const current = target * eased;
        if (target >= 1000 && !isDecimal) {
          const k = current / 1000;
          el.textContent = prefix + (k < 10 ? k.toFixed(1) : Math.round(k).toString()) + 'K' + suffix;
        } else {
          el.textContent = prefix + (isDecimal ? current.toFixed(1) : Math.round(current).toString()) + suffix;
        }
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = final;
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 },
    );

    document.querySelectorAll<HTMLElement>('.stat-value').forEach((el) => io.observe(el));
  }
</script>
