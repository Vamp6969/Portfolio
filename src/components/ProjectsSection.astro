---
import { getCollection } from 'astro:content';
import Doodle from './Doodle.astro';
import Scribble from './Scribble.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Witchly (featured) has its own spread in WitchlySpread.astro
const others = projects.filter((p) => !p.data.featured);

const isExternal = (url: string) => /^https?:\/\//.test(url);

// slug → doodle file in src/assets/doodles
const doodleFor: Record<string, string> = {
  witchly: 'controller',
  'auto-examiner': 'robot',
  'code-debug-env': 'bug',
  'india-finance-mcp': 'plug',
  docspell: 'scroll',
};
const noteColors = ['note-mint', 'note-pink', 'note-violet', 'note-yellow'];
const tilts = [-1.6, 1.2, -0.8, 1.8];
---

<section class="projects section" id="projects" aria-label="Projects">
  <div class="container">
    <header class="reveal">
      <p class="section-eyebrow">/projects</p>
      <h2 class="section-title">More things I've shipped</h2>
      <Scribble kind="underline" color="var(--mint)" class="title-underline" />
      <p class="section-lede">
        Four shipped projects across ML environments, MCP, and SaaS. Hover a note to pull it off the wall.
      </p>
    </header>


    <div class="notes-wall">
      {others.map((p, i) => {
        const ctas = [] as { label: string; url: string }[];
        if (p.data.links.live) ctas.push({ label: 'Live ↗', url: p.data.links.live });
        if (p.data.links.repo) ctas.push({ label: 'GitHub ↗', url: p.data.links.repo });
        return (
          <article class:list={['note', 'proj', 'reveal', noteColors[i % 4]]} style={`--tilt:${tilts[i % 4]}deg`}>
            <Doodle name={doodleFor[p.slug] ?? ''} width={144} class="proj-doodle" />
            <h3 class="proj-title">{p.data.title}</h3>
            <p class="proj-tagline">{p.data.tagline}</p>
            {p.data.description && <p class="proj-desc">{p.data.description}</p>}
            <ul class="tags-list" aria-label="Tags">
              {p.data.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
            <footer class="proj-foot">
              {ctas.map((c) => (
                <a
                  href={c.url}
                  class="proj-cta"
                  target={isExternal(c.url) ? '_blank' : undefined}
                  rel={isExternal(c.url) ? 'noopener' : undefined}
                >{c.label}</a>
              ))}
            </footer>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  header :global(.title-underline) {
    width: min(460px, 85%);
    height: 16px;
    margin: -10px 0 18px;
  }

  /* Wall of equal-size notes */
  .notes-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
    gap: 48px 40px;
  }

  .proj {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .proj :global(.proj-doodle) {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 72px;
    transform: rotate(8deg);
  }

  .proj-title {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 1.85rem;
    line-height: 1.05;
    margin-bottom: 8px;
  }

  .proj-title,
  .proj-tagline { padding-right: 72px; }

  .proj-tagline {
    font-weight: 650;
    margin-bottom: 8px;
  }

  .proj-desc {
    font-size: 0.93rem;
    color: #3d3829;
    margin-bottom: 16px;
  }

  .proj .tags-list { margin-top: auto; }

  .proj-foot {
    display: flex;
    gap: 18px;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1.5px dashed rgba(31, 29, 26, 0.35);
  }

  .proj-cta {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .proj-cta:hover { text-decoration-style: wavy; }
</style>
