---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, tagline, description, tags, links, featured } = project.data;

// CTA priority: internal -> live -> repo
const ctaCandidates: Array<{ key: 'internal' | 'live' | 'repo'; label: string; url: string }> = [];
if (links.internal) ctaCandidates.push({ key: 'internal', label: 'Read case study', url: links.internal });
if (links.live) ctaCandidates.push({ key: 'live', label: 'Live demo', url: links.live });
if (links.repo) ctaCandidates.push({ key: 'repo', label: 'GitHub', url: links.repo });

const primary = ctaCandidates[0];
const secondary = ctaCandidates[1];

const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<article class:list={['card', { featured }]}>
  {featured && <span class="badge">★ Featured</span>}
  <h3 class="card-title">{title}</h3>
  <p class="card-tagline">{tagline}</p>
  {description && <p class="card-desc">{description}</p>}

  <ul class="tags" aria-label="Technologies">
    {tags.map((t) => <li class="tag">{t}</li>)}
  </ul>

  <div class="ctas">
    {primary && (
      <a
        href={primary.url}
        class="cta cta-primary"
        target={isExternal(primary.url) ? '_blank' : undefined}
        rel={isExternal(primary.url) ? 'noopener' : undefined}
      >
        {primary.label} <span aria-hidden="true">→</span>
      </a>
    )}
    {secondary && (
      <a
        href={secondary.url}
        class="cta cta-secondary"
        target={isExternal(secondary.url) ? '_blank' : undefined}
        rel={isExternal(secondary.url) ? 'noopener' : undefined}
      >
        {secondary.label}
      </a>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px;
    transition: all 0.3s var(--ease);
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(8px);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    box-shadow: 0 20px 40px rgba(59, 130, 246, 0.1);
  }

  .card.featured {
    grid-column: 1 / -1;
    background:
      linear-gradient(135deg, rgba(59, 130, 246, 0.06), rgba(6, 182, 212, 0.04)),
      var(--bg-card);
    border-color: rgba(59, 130, 246, 0.3);
  }

  .badge {
    display: inline-block;
    align-self: flex-start;
    background: rgba(6, 182, 212, 0.12);
    color: var(--accent);
    padding: 4px 10px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 1px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }

  .card.featured .card-title {
    font-size: 1.6rem;
    color: var(--accent);
  }

  .card-tagline {
    color: var(--text);
    font-size: 1rem;
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .card-desc {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    background: rgba(6, 182, 212, 0.1);
    padding: 3px 8px;
    border-radius: 3px;
    letter-spacing: 0.5px;
  }

  .ctas {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: auto;
    padding-top: 8px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: all 0.2s var(--ease);
  }

  .cta-primary {
    color: var(--primary);
    font-weight: 600;
  }

  .cta-primary:hover {
    color: var(--accent);
    transform: translateX(2px);
  }

  .cta-secondary {
    color: var(--muted);
  }

  .cta-secondary:hover {
    color: var(--text);
  }
</style>
