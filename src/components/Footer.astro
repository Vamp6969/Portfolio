---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Image
        src={avatar}
        alt=""
        width={20}
        height={20}
        loading="lazy"
        class="footer-avatar"
      />
      <span>Designed & built by Tushar A. — © {year}</span>
    </div>
    <div class="footer-links">
      <a href="https://github.com/Vamp6969" target="_blank" rel="noopener">github</a>
      <a href="/resume">resume</a>
      <a href="mailto:tushar@tushar-a.dev">email</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 32px;
    padding: 24px 0 32px;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted-3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .footer-avatar {
    border-radius: 4px;
    image-rendering: pixelated;
  }

  .footer-links {
    display: flex;
    gap: 18px;
  }

  .footer-links a {
    color: var(--muted-3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    transition: color 0.2s var(--ease);
  }

  .footer-links a:hover {
    color: var(--text);
  }
</style>
