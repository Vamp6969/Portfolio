---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-sign">~ drawn &amp; built by Tushar A., © {year}</p>
    <div class="footer-links">
      <a href="https://github.com/Vamp6969" target="_blank" rel="noopener">GitHub</a>
      <a href="/resume">Resume</a>
      <a href="mailto:tushar@tushar-a.dev">Email</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 2px dashed color-mix(in srgb, var(--ink) 30%, transparent);
    padding-block: 28px 36px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .footer-sign {
    font-family: var(--font-hand);
    font-size: 1.35rem;
    color: var(--muted);
    transform: rotate(-1deg);
  }

  .footer-links {
    display: flex;
    gap: 20px;
    font-weight: 600;
  }

  .footer-links a:hover {
    text-decoration: underline wavy;
    text-underline-offset: 4px;
  }
</style>
