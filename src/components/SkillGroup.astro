---
interface Props {
  title: string;
  tags: string[];
}

const { title, tags } = Astro.props;
---

<div class="skill-box reveal">
  <h3 class="skill-title">{title}</h3>
  <ul class="skill-tags">
    {tags.map((t) => <li class="skill-tag">{t}</li>)}
  </ul>
</div>

<style>
  .skill-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 26px;
    transition: all 0.3s var(--ease);
    backdrop-filter: blur(8px);
  }

  .skill-box:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
  }

  .skill-title {
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .skill-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    background: rgba(6, 182, 212, 0.1);
    padding: 5px 10px;
    border-radius: 4px;
    letter-spacing: 0.3px;
  }
</style>
