---
// Renders src/assets/doodles/<name>.png if it exists, otherwise nothing,
// so the layout works before (and without) every piece of art.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  width: number;
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { name, width, alt = '', class: cls, loading = 'lazy' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/doodles/*.{png,jpg,jpeg,webp}', { eager: true });
const src = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === name)?.[1].default;
---
{src && (
  <Image
    src={src}
    width={width}
    alt={alt}
    loading={loading}
    class:list={['doodle', cls]}
    aria-hidden={alt ? undefined : 'true'}
  />
)}
