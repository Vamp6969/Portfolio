---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
---

<header id="about" class="hero">
  <div class="container hero-inner">
    <div class="hero-mesh" aria-hidden="true"></div>

    <div class="hero-grid">
      <div class="hero-avatar-wrap">
        <Image
          src={avatar}
          alt="Tushar A. — Minecraft-style avatar"
          width={120}
          height={120}
          loading="eager"
          class="hero-avatar"
        />
      </div>

      <div class="hero-text reveal">
        <p class="hero-label">// HI, I'M</p>
        <h1 class="hero-name">Tushar A.</h1>
        <h2 class="hero-tagline">I scale infrastructure.</h2>
        <p class="hero-blurb">
          Founded a game-hosting ISP at 17 → still running it solo at 10,000 users.
          Also shipping AI/ML projects and maintaining MistyMC.
        </p>
        <div class="hero-pill">
          <span class="pulse" aria-hidden="true"></span>
          Available — full-time
        </div>
        <div class="hero-ctas">
          <a href="/witchly" class="btn btn-primary">Read case study</a>
          <a href="#contact" class="btn btn-outline">Get in touch</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 40px;
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 20% 40%, rgba(59, 130, 246, 0.12), transparent 35%),
      radial-gradient(circle at 80% 60%, rgba(6, 182, 212, 0.12), transparent 35%);
    animation: meshDrift 14s ease-in-out infinite alternate;
  }

  @keyframes meshDrift {
    0% {
      background-position: 0% 0%, 100% 100%;
    }
    100% {
      background-position: 10% 10%, 90% 90%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mesh {
      animation: none;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (max-width: 640px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .hero-avatar-wrap {
    position: relative;
  }

  .hero-avatar {
    border-radius: 12px;
    image-rendering: pixelated;
    border: 2px solid var(--border-strong);
    box-shadow:
      0 0 0 4px rgba(59, 130, 246, 0.08),
      0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .hero-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .hero-name {
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -2px;
    background: linear-gradient(to right, #fff, #9ca3af);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 8px;
  }

  .hero-tagline {
    font-size: clamp(1.6rem, 4vw, 3.2rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -1.5px;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .hero-blurb {
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    max-width: 600px;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid rgba(59, 130, 246, 0.4);
    background: rgba(59, 130, 246, 0.1);
    color: var(--primary);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-bottom: 32px;
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 0 0 rgba(0, 255, 122, 0.7);
    animation: pulse 2s var(--ease) infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 255, 122, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(0, 255, 122, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 255, 122, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid transparent;
    transition: all 0.25s var(--ease);
  }

  .btn-primary {
    background: var(--primary);
    color: #fff;
  }

  .btn-primary:hover {
    background: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);
  }

  .btn-outline {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .btn-outline:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }
</style>
