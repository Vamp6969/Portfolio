---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Doodle from './Doodle.astro';
import Scribble from './Scribble.astro';

const hasPortrait = Object.keys(import.meta.glob('../assets/doodles/portrait.*')).length > 0;

// Hand-written callouts around the portrait ("fig. 1"). pos = corner on desktop.
const callouts = [
  { pos: 'tl', text: 'founded Witchly at 17', sub: 'bootstrapped, zero funding' },
  { pos: 'tr', text: '10K+ users', sub: '99.9% uptime on bare metal' },
  { pos: 'bl', text: 'Bangalore, IN', sub: 'remote / on-site' },
  { pos: 'br', text: 'TS · Rust · Python', sub: '+ a lot of Linux' },
];
---

<section class="hero" id="about" aria-label="Introduction">
  <Doodle name="rocket" width={120} class="margin-doodle md-rocket" />
  <Doodle name="coffee" width={100} class="margin-doodle md-coffee" />

  <div class="container hero-inner">
    <div class="hero-text">
      <p class="section-eyebrow reveal">hi, my name is</p>
      <h1 class="hero-name reveal">Tushar</h1>
      <p class="hero-tagline reveal">I scale <span class="hl">infrastructure.</span></p>
      <p class="hero-blurb reveal">
        Systems engineer &amp; founder. I took a free game-server host from zero to
        <strong>10,000+ users</strong> on bare-metal Hetzner. These days I also ship AI/ML and MCP work.
      </p>
      <div class="hero-row reveal">
        <a href="#witchly" class="btn btn-primary">See how Witchly works ↓</a>
        <a href="#contact" class="btn">Say hi</a>
      </div>
      <span class="status-pill reveal">available for full-time</span>
    </div>

    <div class="fig reveal">
      <figure class="polaroid" style="--tilt: 3deg">
        <span class="polaroid-tape" aria-hidden="true"></span>
        <div class="polaroid-photo">
          {hasPortrait ? (
            <Doodle name="portrait" width={280} alt="Doodle portrait of Tushar" loading="eager" class="portrait" />
          ) : (
            <Image src={avatar} alt="Tushar A., Minecraft-style avatar" width={200} height={200} loading="eager" class="portrait pixel" />
          )}
        </div>
        <figcaption>
          <a href="https://discord.com/users/844426168793825330" target="_blank" rel="noopener" aria-label="Discord: @vamp_">fig. 1: me (@vamp)</a>
        </figcaption>
      </figure>

      <ul class="callouts">
        {callouts.map((c) => (
          <li class={`callout callout-${c.pos}`}>
            <span class="callout-text">{c.text}</span>
            <span class="callout-sub">{c.sub}</span>
            <Scribble kind="arrow" class="callout-arrow" />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-top: 120px;
    padding-bottom: 56px;
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .hero-name {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: clamp(4rem, 11vw, 8rem);
    line-height: 0.9;
    color: var(--ink);
  }

  .hero-tagline {
    font-family: var(--font-hand);
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1.1;
    color: var(--ink);
    margin: 6px 0 22px;
  }

  .hero-blurb {
    color: var(--muted);
    font-size: clamp(1.05rem, 1.6vw, 1.15rem);
    max-width: 520px;
    margin-bottom: 28px;
  }

  .hero-blurb strong { color: var(--ink); }

  .hero-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 26px;
  }

  /* fig. 1: labelled diagram */
  .fig {
    position: relative;
    height: 520px;
    display: grid;
    place-items: center;
  }

  .polaroid {
    position: relative;
    z-index: 1;
    background: #fff;
    padding: 14px 14px 8px;
    box-shadow: var(--paper-shadow);
    border: 1px solid rgba(0, 0, 0, 0.06);
    width: 250px;
    transform: rotate(var(--tilt));
  }

  .polaroid-tape {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 100px;
    height: 28px;
    transform: translateX(-50%) rotate(-4deg);
    background: color-mix(in srgb, var(--yellow) 70%, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .polaroid-photo {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: var(--bg);
    border: 1.5px solid var(--ink);
    overflow: hidden;
  }

  .polaroid-photo :global(.portrait) { width: 100%; height: 100%; object-fit: contain; }
  .polaroid-photo :global(.pixel) { image-rendering: pixelated; width: 74%; height: auto; }

  .polaroid figcaption {
    text-align: center;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    padding-top: 6px;
  }

  .polaroid figcaption a:hover { color: var(--violet-ink); }

  .callouts { list-style: none; }

  .callout {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: 170px;
    line-height: 1.15;
  }

  .callout-text {
    font-family: var(--font-hand);
    font-size: 1.5rem;
    color: var(--ink);
  }

  .callout-sub {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 2px;
  }

  .callout :global(.callout-arrow) {
    position: absolute;
    width: 70px;
    height: 52px;
  }

  /* corners; arrows point inward to the portrait */
  .callout-tl { top: 10px; left: 0; }
  .callout-tl :global(.callout-arrow) { top: 52px; left: 90px; }

  .callout-tr { top: 30px; right: 0; text-align: right; align-items: flex-end; }
  .callout-tr :global(.callout-arrow) { top: 56px; right: 96px; transform: scaleX(-1); }

  .callout-bl { bottom: 30px; left: 0; }
  .callout-bl :global(.callout-arrow) { bottom: 56px; left: 92px; transform: scaleY(-1); }

  .callout-br { bottom: 10px; right: 0; text-align: right; align-items: flex-end; }
  .callout-br :global(.callout-arrow) { bottom: 52px; right: 90px; transform: scale(-1, -1); }

  /* Margin doodles */
  .hero :global(.margin-doodle) { position: absolute; }
  .hero :global(.md-rocket) { top: 110px; right: 2%; transform: rotate(14deg); }
  .hero :global(.md-coffee) { bottom: 30px; left: 2%; transform: rotate(-8deg); }

  @media (max-width: 1240px) {
    .hero :global(.margin-doodle) { display: none; }
  }

  @media (max-width: 980px) {
    .hero-inner { grid-template-columns: 1fr; }
    .fig {
      height: auto;
      grid-template-columns: 1fr 1fr;
      gap: 18px 24px;
      margin-top: 16px;
      justify-items: center;
    }
    .polaroid { grid-column: 1 / -1; width: 210px; margin-bottom: 8px; }
    .callouts { display: contents; }
    .callout {
      position: static;
      width: auto;
      text-align: center !important;
      align-items: center !important;
    }
    .callout :global(.callout-arrow) { display: none; }
  }

  @media (max-width: 540px) {
    .callout-text { font-size: 1.25rem; }
  }
</style>
