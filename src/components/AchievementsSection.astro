---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Scribble from './Scribble.astro';

const items = (await getCollection('achievements')).sort((a, b) => a.data.order - b.data.order);

// rosette colour + centre glyph per kind (podium entries show their place number)
const kinds = {
  place: { fill: 'var(--yellow)', glyph: '★' },
  finalist: { fill: 'var(--violet)', glyph: '✦' },
  participation: { fill: 'var(--mint)', glyph: '✓' },
  cert: { fill: 'var(--pink)', glyph: '✓' },
} as const;
---

{items.length > 0 && (
  <section class="wins section" id="achievements" aria-label="Achievements and certifications">
    <div class="container">
      <header class="reveal">
        <p class="section-eyebrow">/achievements</p>
        <h2 class="section-title">Wins &amp; certificates</h2>
        <Scribble kind="underline" color="var(--yellow)" class="title-underline" />
        <p class="section-lede">Hackathons, awards and certifications, pinned to the wall.</p>
      </header>

      <ul class="wins-grid">
        {items.map(({ data }, i) => {
          const k = kinds[data.kind];
          return (
            <li class="sketch win reveal" style={`--tilt:${[-0.8, 0.6, -0.4][i % 3]}deg`}>
              <div class="rosette" style={`--fill:${k.fill}`} aria-hidden="true">
                <svg viewBox="0 0 80 110" fill="none">
                  <path d="M26 58 L16 104 L29 95 L36 108 L42 62" fill="var(--fill)" stroke="#1f1d1a" stroke-width="2.4" stroke-linejoin="round" />
                  <path d="M54 58 L64 104 L51 95 L44 108 L38 62" fill="var(--fill)" stroke="#1f1d1a" stroke-width="2.4" stroke-linejoin="round" />
                  <path d="M40 4 l7 6 9-2 3 9 9 3-2 9 6 7-6 7 2 9-9 3-3 9-9-2-7 6-7-6-9 2-3-9-9-3 2-9-6-7 6-7-2-9 9-3 3-9 9 2z" fill="var(--fill)" stroke="#1f1d1a" stroke-width="2.4" stroke-linejoin="round" />
                  <circle cx="40" cy="40" r="17" fill="#fffdf8" stroke="#1f1d1a" stroke-width="2" />
                </svg>
                <span class:list={['rosette-glyph', data.place && 'is-place']}>{data.place ?? k.glyph}</span>
              </div>

              <div class="win-body">
                {data.date && <p class="win-kind">{data.date}</p>}
                <h3 class="win-title">{data.title}</h3>
                <p class="win-event">{data.event}</p>
                {data.detail && <p class="win-detail">{data.detail}</p>}

                {data.image && (
                  <a class="win-cert" href={data.image.src} target="_blank" rel="noopener" aria-label={`View certificate: ${data.title}, ${data.event}`}>
                    <span class="win-cert-tape" aria-hidden="true"></span>
                    <Image src={data.image} alt="" width={320} />
                  </a>
                )}

                {data.link && (
                  <a class="win-link" href={data.link} target="_blank" rel="noopener">View ↗</a>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<style>
  header :global(.title-underline) {
    width: min(380px, 80%);
    height: 16px;
    margin: -10px 0 18px;
  }

  .wins-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 32px;
  }

  .win {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .rosette {
    position: relative;
    flex: none;
    width: 64px;
    margin-top: -2px;
    transform: rotate(-8deg);
  }

  .rosette svg { width: 100%; height: auto; }

  .rosette-glyph {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding-bottom: 6px;
    font-size: 1.15rem;
    line-height: 1;
    color: #1f1d1a;
  }

  .win-body { min-width: 0; }

  .win-kind {
    font-family: var(--font-hand);
    font-size: 1.15rem;
    color: var(--violet-ink);
    line-height: 1.2;
  }

  .rosette-glyph.is-place {
    font-family: var(--font-hand);
    font-size: 1.6rem;
  }

  .win-title {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 1.9rem;
    line-height: 1.05;
    color: var(--ink);
  }

  .win-event {
    font-weight: 650;
    color: var(--ink);
    margin: 2px 0 8px;
  }

  .win-detail {
    font-size: 0.94rem;
    color: var(--muted);
  }

  .win-cert {
    position: relative;
    display: block;
    width: fit-content;
    max-width: min(100%, 260px);
    margin-top: 18px;
    padding: 8px;
    background: #fff;
    box-shadow: var(--paper-shadow);
    transform: rotate(1.5deg);
    transition: transform 0.3s var(--spring);
  }

  .win-cert:hover { transform: rotate(0deg) scale(1.03); }

  .win-cert-tape {
    position: absolute;
    top: -10px;
    left: 50%;
    width: 70px;
    height: 20px;
    transform: translateX(-50%) rotate(-3deg);
    background: color-mix(in srgb, var(--yellow) 70%, transparent);
  }

  .win-cert :global(img) { display: block; width: auto; max-width: 100%; max-height: 180px; }

  .win-link {
    display: inline-block;
    margin-top: 12px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .win-link:hover { text-decoration-style: wavy; }

  @media (max-width: 420px) {
    .rosette { width: 52px; }
  }
</style>
