---
import { getEntry } from 'astro:content';

const entry = await getEntry('now', 'now');
const { Content } = entry ? await entry.render() : { Content: null };
const data = entry?.data;

const updated = data
  ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(data.updated)
  : '';
---

<article class="tile now-tile span-12 row-2 reveal" id="now">
  <p class="tile-label">/now</p>
  <div class="now-head">
    <span class="now-live">live</span>
    <span class="now-meta">{data?.location} · Updated {updated}</span>
  </div>
  <div class="now-body">
    {Content ? <Content /> : <p>Updates coming soon.</p>}
  </div>
</article>

<style>
  .now-tile {
    background:
      linear-gradient(135deg, rgba(34, 197, 94, 0.06), rgba(99, 102, 241, 0.04)),
      var(--tile-bg);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .now-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .now-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--good-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .now-live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 8px var(--good);
    animation: pulse 2s var(--ease) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .now-live::before { animation: none; }
  }

  .now-meta {
    color: var(--muted-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.5px;
  }

  .now-body {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.65;
  }

  .now-body :global(p) {
    margin: 0;
  }

  .now-body :global(p + p) {
    margin-top: 8px;
  }

  .now-body :global(strong) {
    color: var(--primary-soft);
    font-weight: 600;
  }
</style>
