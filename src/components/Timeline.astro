---
interface Entry {
  role: string;
  org: string;
  link?: string;
  period: string;
  location?: string;
  bullets: string[];
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<section class="experience section" id="experience">
  <div class="container">
    <h2 class="section-title reveal">
      <span class="section-number">01.</span> Where I've worked
    </h2>

    <div class="timeline">
      {entries.map((e) => (
        <article class="job reveal">
          <div class="job-marker" aria-hidden="true"></div>
          <header class="job-head">
            <h3 class="job-title">
              {e.role} <span class="job-org">@ {e.link ? <a href={e.link} target="_blank" rel="noopener">{e.org}</a> : e.org}</span>
            </h3>
            <p class="job-meta">{e.period}{e.location ? ` · ${e.location}` : ''}</p>
          </header>
          <ul class="job-bullets">
            {e.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </article>
      ))}
      </div>
    </div>
</section>

<style>
  .timeline {
    border-left: 2px solid var(--border-strong);
    margin-left: 8px;
    padding-left: 36px;
    position: relative;
  }

  .job {
    position: relative;
    margin-bottom: 56px;
  }

  .job:last-child {
    margin-bottom: 0;
  }

  .job-marker {
    position: absolute;
    left: -45px;
    top: 6px;
    width: 14px;
    height: 14px;
    background: var(--bg);
    border: 2px solid var(--primary);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--bg);
  }

  .job-title {
    font-size: 1.35rem;
    color: var(--text);
    font-weight: 700;
  }

  .job-org {
    color: var(--primary);
    font-weight: 600;
  }

  .job-org a {
    color: inherit;
    border-bottom: 1px dashed transparent;
    transition: border-color 0.2s var(--ease);
  }

  .job-org a:hover {
    border-bottom-color: currentColor;
  }

  .job-meta {
    font-family: var(--font-mono);
    color: var(--muted);
    margin: 6px 0 16px;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
  }

  .job-bullets {
    list-style: none;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .job-bullets li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 8px;
  }

  .job-bullets li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
