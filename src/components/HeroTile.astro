---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
---

<article class="tile hero span-8 row-4 reveal" id="about" aria-label="Hero">
  <div class="hero-mesh" aria-hidden="true"></div>

  <div class="hero-top">
    <div class="hero-text">
      <p class="tile-label">/about</p>
      <h1 class="hero-name">Tushar A.</h1>
      <p class="hero-tag">I scale infrastructure.</p>
    </div>
    <Image
      src={avatar}
      alt="Tushar A. — Minecraft-style avatar"
      width={88}
      height={88}
      loading="eager"
      class="hero-avatar"
    />
  </div>

  <div class="hero-bottom">
    <p class="hero-blurb">
      Founded a game-hosting ISP at 17 → still running it solo at 10,000 users on
      bare-metal Hetzner. Also shipping AI/ML projects and maintaining MistyMC.
    </p>
    <div class="hero-row">
      <a href="/witchly" class="btn btn-primary">Read case study</a>
      <a href="#contact" class="btn btn-outline">Get in touch</a>
    </div>
    <span class="status-pill">Available — full-time</span>
  </div>
</article>

<style>
  .hero {
    padding: clamp(22px, 3vw, 30px);
    background:
      radial-gradient(circle at 20% 30%, rgba(99, 102, 241, 0.14), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(168, 85, 247, 0.10), transparent 50%),
      var(--tile-bg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 360px;
  }

  .hero-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 30% 20%, rgba(99, 102, 241, 0.08), transparent 30%),
      radial-gradient(circle at 70% 80%, rgba(168, 85, 247, 0.08), transparent 30%);
    animation: meshDrift 16s ease-in-out infinite alternate;
    opacity: 0.7;
  }

  @keyframes meshDrift {
    0% { background-position: 0% 0%, 100% 100%; }
    100% { background-position: 12% 8%, 88% 92%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mesh { animation: none; }
  }

  .hero-top,
  .hero-bottom {
    position: relative;
    z-index: 1;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
  }

  .hero-text {
    flex: 1;
  }

  .hero-name {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -2px;
    line-height: 0.95;
    background: linear-gradient(135deg, #fff 0%, var(--primary-soft) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-tag {
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.8px;
    color: var(--primary-soft);
    margin-top: 6px;
  }

  .hero-avatar {
    border-radius: 14px;
    image-rendering: pixelated;
    border: 2px solid var(--border-strong);
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.10);
    flex-shrink: 0;
  }

  .hero-blurb {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 560px;
    margin-bottom: 18px;
  }

  .hero-row {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 540px) {
    .hero-avatar {
      width: 60px !important;
      height: 60px !important;
    }
    .hero-name { font-size: 2.4rem; }
    .hero-tag { font-size: 1.2rem; }
  }
</style>
