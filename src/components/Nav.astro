---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';

const items = isHome
  ? [
      { label: 'About', href: '#about' },
      { label: 'Now', href: '#now' },
      { label: 'Work', href: '#experience' },
      { label: 'Projects', href: '#projects' },
      { label: 'Contact', href: '#contact' },
    ]
  : [
      { label: 'Home', href: '/' },
      { label: 'Witchly', href: '/witchly' },
      { label: 'Resume', href: '/resume' },
    ];
---

<nav class="pill-nav" aria-label="Primary navigation">
  <a href="/" class="pill-brand" aria-label="Home">
    <Image
      src={avatar}
      alt="Tushar A. — Minecraft-style avatar"
      width={26}
      height={26}
      loading="eager"
      class="pill-avatar"
    />
  </a>

  <span class="pill-divider" aria-hidden="true"></span>

  <ul class="pill-items" role="menubar">
    <span class="pill-indicator" aria-hidden="true"></span>
    {items.map((item) => (
      <li role="none">
        <a
          href={item.href}
          class="pill-item"
          data-section={item.href.startsWith('#') ? item.href.slice(1) : ''}
          role="menuitem"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>

  <span class="pill-divider" aria-hidden="true"></span>

  <a href="/resume" class="pill-cta">
    Resume
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
      <path d="M2 8L8 2M8 2H3.5M8 2V6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </a>
</nav>

<style>
  .pill-nav {
    position: fixed;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 8px 6px 6px;
    background: rgba(10, 10, 16, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 12px 40px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(99, 102, 241, 0.05);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      background 0.4s var(--ease);
    font-family: var(--font-mono);
  }

  .pill-nav.scrolled {
    background: rgba(10, 10, 16, 0.85);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 16px 48px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(99, 102, 241, 0.08);
  }

  .pill-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    transition: transform 0.2s var(--ease);
  }

  .pill-brand:hover {
    transform: scale(1.05);
  }

  .pill-avatar {
    border-radius: 50%;
    image-rendering: pixelated;
  }

  .pill-divider {
    width: 1px;
    height: 20px;
    background: var(--border);
    margin: 0 4px;
  }

  .pill-items {
    position: relative;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* Sliding active-state pill — animated via CSS vars set from JS */
  .pill-indicator {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate3d(var(--ind-x, 0), -50%, 0);
    width: var(--ind-w, 0);
    height: 28px;
    background: rgba(99, 102, 241, 0.16);
    border: 1px solid rgba(165, 180, 252, 0.18);
    border-radius: 999px;
    pointer-events: none;
    transition:
      transform 0.45s cubic-bezier(0.5, 0, 0.1, 1),
      width 0.45s cubic-bezier(0.5, 0, 0.1, 1),
      opacity 0.3s var(--ease);
    opacity: 0;
    z-index: 0;
  }

  .pill-items[data-has-active='true'] .pill-indicator {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pill-indicator {
      transition: opacity 0.2s var(--ease);
    }
  }

  .pill-item {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 500;
    border-radius: 999px;
    transition: color 0.25s var(--ease);
    letter-spacing: 0.2px;
  }

  .pill-item:hover {
    color: var(--text-strong);
  }

  .pill-item[data-active='true'] {
    color: var(--text-strong);
  }

  .pill-cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 14px;
    background: var(--text-strong);
    color: var(--bg) !important;
    font-size: 0.78rem;
    font-weight: 600;
    border-radius: 999px;
    transition: transform 0.2s var(--ease);
  }

  .pill-cta:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    .pill-nav {
      gap: 2px;
      padding: 5px;
      max-width: calc(100vw - 24px);
    }
    .pill-divider:first-of-type { display: none; }
    .pill-item { padding: 6px 9px; font-size: 0.72rem; }
    .pill-cta { padding: 6px 11px; font-size: 0.72rem; }
  }

  @media (max-width: 540px) {
    .pill-nav {
      gap: 0;
      padding: 4px;
    }
    .pill-divider { display: none; }
    .pill-item { padding: 6px 8px; font-size: 0.7rem; }
    .pill-cta { padding: 5px 10px; font-size: 0.7rem; }
    .pill-brand { width: 30px; height: 30px; }
  }

  @media (max-width: 380px) {
    /* Hide non-essential items on the smallest screens */
    .pill-item[data-section='now'],
    .pill-item[data-section='experience'] {
      display: none;
    }
  }
</style>

<script>
  // Floating-nav: scroll-aware backdrop, IntersectionObserver-driven active
  // section, and a sliding pill indicator that morphs between items.
  const nav = document.querySelector<HTMLElement>('.pill-nav');
  const itemList = document.querySelector<HTMLElement>('.pill-items');
  const items = document.querySelectorAll<HTMLAnchorElement>('.pill-item[data-section]');
  const sectionToItem = new Map<string, HTMLAnchorElement>();

  for (const item of items) {
    const sec = item.dataset.section;
    if (sec) sectionToItem.set(sec, item);
  }

  if (nav) {
    const onScroll = () => {
      nav.classList.toggle('scrolled', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const moveIndicatorTo = (el: HTMLElement | null) => {
    if (!itemList) return;
    if (!el) {
      itemList.dataset.hasActive = 'false';
      return;
    }
    const listRect = itemList.getBoundingClientRect();
    const itemRect = el.getBoundingClientRect();
    const x = itemRect.left - listRect.left;
    const w = itemRect.width;
    itemList.style.setProperty('--ind-x', `${x}px`);
    itemList.style.setProperty('--ind-w', `${w}px`);
    itemList.dataset.hasActive = 'true';
  };

  if (sectionToItem.size > 0) {
    const visible = new Map<string, number>();

    const setActive = () => {
      let activeId = '';
      let topRatio = -1;
      for (const [id, ratio] of visible) {
        if (ratio > topRatio) {
          topRatio = ratio;
          activeId = id;
        }
      }
      for (const item of items) item.dataset.active = 'false';
      const active = sectionToItem.get(activeId);
      if (active) {
        active.dataset.active = 'true';
        moveIndicatorTo(active);
      } else {
        moveIndicatorTo(null);
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = entry.target.id;
          if (entry.isIntersecting) {
            visible.set(id, entry.intersectionRatio);
          } else {
            visible.delete(id);
          }
        }
        setActive();
      },
      {
        rootMargin: '-30% 0px -55% 0px',
        threshold: [0, 0.25, 0.5, 0.75, 1],
      },
    );

    for (const id of sectionToItem.keys()) {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    }

    // Hover preview: temporarily glide indicator to the hovered item
    let restoreTimer: number | undefined;
    const findActive = () => Array.from(items).find((i) => i.dataset.active === 'true') ?? null;

    items.forEach((it) => {
      it.addEventListener('mouseenter', () => {
        if (restoreTimer) clearTimeout(restoreTimer);
        moveIndicatorTo(it);
      });
      it.addEventListener('mouseleave', () => {
        restoreTimer = window.setTimeout(() => moveIndicatorTo(findActive()), 80);
      });
    });

    // Recompute on resize so indicator stays aligned
    window.addEventListener('resize', () => moveIndicatorTo(findActive()), { passive: true });
  }
</script>
