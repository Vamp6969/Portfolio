---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';
---

<nav class="nav">
  <a href="/" class="nav-brand" aria-label="Home">
    <Image
      src={avatar}
      alt="Tushar A. — Minecraft-style avatar"
      width={28}
      height={28}
      loading="eager"
      class="nav-avatar"
    />
    <span class="nav-logo">Tushar<span class="dot">.dev</span></span>
  </a>

  <div class="nav-links">
    {isHome ? (
      <>
        <a href="#about">about</a>
        <a href="#experience">work</a>
        <a href="#projects">projects</a>
        <a href="#contact">contact</a>
      </>
    ) : (
      <>
        <a href="/">home</a>
        <a href="/witchly">witchly</a>
        <a href="/resume">resume</a>
      </>
    )}
    <a href="/Resume.pdf" class="nav-cta" target="_blank" rel="noopener">Resume</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px clamp(16px, 4vw, 40px);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(5, 5, 8, 0.7);
    border-bottom: 1px solid var(--border);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-avatar {
    border-radius: 6px;
    image-rendering: pixelated;
    border: 1px solid var(--border-strong);
  }

  .nav-logo {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: -0.5px;
    color: var(--text);
  }

  .nav-logo .dot {
    color: var(--primary-soft);
  }

  .nav-links {
    display: flex;
    gap: 22px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .nav-links a {
    color: var(--muted-3);
    transition: color 0.2s var(--ease);
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-cta {
    background: var(--text-strong);
    color: var(--bg) !important;
    padding: 6px 14px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.78rem;
  }

  .nav-cta:hover {
    background: #fff;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .nav-links a:not(.nav-cta) {
      display: none;
    }
  }
</style>
