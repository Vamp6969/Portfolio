---
interface Group {
  cat: string;
  tags: string[];
}

interface Props {
  groups: Group[];
}

const { groups } = Astro.props;
---

<article class="tile skills-tile span-8 row-2 reveal" id="skills">
  <p class="tile-label">/skills</p>
  <div class="skills-list">
    {groups.map((g) => (
      <div class="skill-row">
        <p class="skill-cat">[{g.cat}]</p>
        <ul class="skill-tags">
          {g.tags.map((t) => <li class="skill-tag">{t}</li>)}
        </ul>
      </div>
    ))}
  </div>
</article>

<style>
  .skills-tile {
    display: flex;
    flex-direction: column;
  }

  .skills-list {
    display: flex;
    flex-direction: column;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 14px;
    padding: 8px 0;
    align-items: center;
    border-bottom: 1px solid var(--divider);
  }

  .skill-row:last-child {
    border-bottom: none;
  }

  .skill-cat {
    color: var(--primary-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .skill-tags {
    list-style: none;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 3px 8px;
    background: rgba(99, 102, 241, 0.10);
    color: var(--accent);
    border-radius: 4px;
    letter-spacing: 0.3px;
  }

  @media (max-width: 540px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
