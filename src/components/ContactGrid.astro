---
interface Contact {
  label: string;
  value: string;
  href: string;
  icon: string;
  external?: boolean;
}

const contacts: Contact[] = [
  { label: 'Email', value: 'tushar@tushar-a.dev', href: 'mailto:tushar@tushar-a.dev', icon: '✉' },
  { label: 'WhatsApp', value: 'Chat on WhatsApp', href: 'https://wa.me/+919113058142', icon: '✆', external: true },
  { label: 'LinkedIn', value: 'Connect', href: 'https://www.linkedin.com/in/tushar-a-607371315', icon: 'in', external: true },
  { label: 'GitHub', value: '@Vamp6969', href: 'https://github.com/Vamp6969', icon: '⌥', external: true },
  { label: 'GitHub (Org)', value: '@Witchly', href: 'https://github.com/Witchly', icon: '⌥', external: true },
  { label: 'Discord', value: '@vamp_', href: 'https://discord.com/users/844426168793825330', icon: '◇', external: true },
];
---

<section class="contact section" id="contact">
  <div class="container">
    <h2 class="section-title reveal">
      <span class="section-number">04.</span> Get in touch
    </h2>

    <div class="contact-intro reveal">
      <p>
        Open to full-time roles in DevOps, infrastructure, or platform engineering — and to
        consulting on scaling, hosting, and infra security. Inbox is always open for technical
        questions or just to say hi.
      </p>
    </div>

    <div class="contact-grid reveal">
      {contacts.map((c) => (
        <a
          href={c.href}
          class="contact-card"
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'noopener' : undefined}
        >
          <span class="contact-icon" aria-hidden="true">{c.icon}</span>
          <span class="contact-label">{c.label}</span>
          <span class="contact-value">{c.value}</span>
        </a>
      ))}
    </div>

    <div class="contact-buttons reveal">
      <a href="https://wa.me/+919113058142" class="big-btn" target="_blank" rel="noopener">
        Say hello →
      </a>
      <a href="/Resume.pdf" class="big-btn" target="_blank" rel="noopener">
        Resume.pdf
      </a>
      <a href="/witchly" class="big-btn">
        Witchly case study
      </a>
    </div>
  </div>
</section>

<style>
  .contact-intro {
    max-width: 700px;
    margin: 0 auto 48px;
    text-align: center;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 56px;
  }

  .contact-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transition: all 0.3s var(--ease);
  }

  .contact-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    background: rgba(40, 40, 40, 0.7);
  }

  .contact-icon {
    font-size: 1.6rem;
    color: var(--primary);
    margin-bottom: 4px;
    transition: color 0.2s var(--ease);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .contact-card:hover .contact-icon {
    color: var(--accent);
  }

  .contact-label {
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .contact-value {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .contact-buttons {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .big-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border: 1px solid var(--primary);
    color: var(--primary);
    background: var(--bg-card);
    font-size: 1rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    transition: all 0.25s var(--ease);
  }

  .big-btn:hover {
    background: var(--primary);
    color: #fff;
    transform: translateY(-2px);
  }
</style>
