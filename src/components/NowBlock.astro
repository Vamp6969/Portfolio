---
import { getEntry } from 'astro:content';

const entry = await getEntry('now', 'now');
const { Content } = entry ? await entry.render() : { Content: null };
const data = entry?.data;

const updated = data
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(data.updated)
  : '';
---

<section class="now-section" id="now" aria-label="What I'm doing now">
  <div class="container">
    <div class="note note-yellow now-card reveal" style="--tilt: -1.2deg">
      <div class="now-head">
        <span class="now-title">right now…</span>
        <span class="now-meta">{data?.location} · updated {updated}</span>
      </div>
      <div class="now-body">
        {Content ? <Content /> : <p>Updates coming soon.</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .now-section {
    padding-block: clamp(24px, 4vw, 48px);
  }

  .now-card {
    max-width: 760px;
    margin-inline: auto;
  }

  .now-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 8px;
  }

  .now-title {
    font-family: var(--font-hand);
    font-size: 1.9rem;
    line-height: 1;
  }

  .now-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #4a4436;
  }

  .now-body :global(p) {
    font-size: 1.05rem;
  }

  .now-body :global(strong) {
    font-weight: 700;
    text-decoration: underline wavy rgba(31, 29, 26, 0.45);
    text-underline-offset: 4px;
  }
</style>
