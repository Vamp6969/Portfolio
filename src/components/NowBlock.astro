---
import { getEntry } from 'astro:content';

const entry = await getEntry('now', 'now');
const { Content } = entry ? await entry.render() : { Content: null };
const data = entry?.data;

const formatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updated = data ? formatter.format(data.updated) : '';
---

<section class="now reveal" id="now" aria-label="What I'm doing right now">
  <div class="container">
    <div class="now-card">
      <div class="now-header">
        <span class="now-label">
          <span class="now-pulse" aria-hidden="true"></span>
          /now
        </span>
        <span class="now-meta">{data?.location} · Updated {updated}</span>
      </div>
      <div class="now-body">
        {Content ? <Content /> : <p>Updates coming soon.</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .now {
    padding-block: clamp(50px, 8vw, 80px);
  }

  .now-card {
    background:
      linear-gradient(135deg, rgba(59, 130, 246, 0.06), rgba(6, 182, 212, 0.06));
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: clamp(24px, 4vw, 36px);
  }

  .now-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  .now-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .now-pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 8px var(--good);
    animation: nowPulse 2s var(--ease) infinite;
  }

  @keyframes nowPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-pulse {
      animation: none;
    }
  }

  .now-meta {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 1px;
  }

  .now-body {
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .now-body :global(p) {
    margin-bottom: 0.6em;
  }

  .now-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .now-body :global(strong) {
    color: var(--accent);
  }
</style>
