# Cloudflare Pages headers — applied to the served files in dist/.
# Most specific paths first; the global /* rule applies to everything else.

# Hashed Astro assets — safe to cache forever (filename changes on rebuild)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted variable fonts — versioned by filename, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images, OG, favicons — 1 day cache (filenames are stable; bust on regen)
/*.png
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.gif
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400

# PDFs — short cache so resume/case-study updates propagate fast.
# 5 min browser/CDN cache + must-revalidate (browser checks before serving stale).
/*.pdf
  Cache-Control: public, max-age=300, must-revalidate

# Security headers for everything (HTML included)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
